{
  "name": "trebol-printer",
  "version": "1.1.0",
  "description": "Impresión térmica automática para Distribuidora Trébol",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.trebol.printer",
    "productName": "Trébol Printer",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "raw-printer.js",
      "gdi-printer.js",
      "node_modules/**"
    ],
    "extraResources": [
      { "from": "send-gdi.ps1", "to": "send-gdi.ps1" },
      { "from": "send-raw.ps1", "to": "send-raw.ps1" }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
